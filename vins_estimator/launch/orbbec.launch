<launch>
    <arg name="config_path" default = "/home/tlha/catkin_ws/src/H3-Mapping/src/fvins/config/orbbec/orbbec_480p.yaml" />
    <arg name="vins_path" default = "/home/tlha/catkin_ws/src/H3-Mapping/src/fvins" />

    <node pkg="image_transport" type="republish" name="republish" args="compressed in:=/camera/color/image_raw raw out:=/camera/color/image_raw" output="screen" respawn="true"/>       
    <node name="rvizvisualisation" pkg="rviz" type="rviz" output="log" args="-d $(find vins)/../config/vins_rviz_config.rviz" />

</launch>
